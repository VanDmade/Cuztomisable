{
    "name": "vandmade/cuztomisable",
    "description": "Customizable dashboard to be used to initialize the structure of a dashboard / portal",
    "type": "package",
    "license": "Apache License",
    "autoload": {
        "psr-4": {
            "VanDmade\\Cuztomisable\\": "src/"
        },
        "classmap": ["src/"],
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VanDmade\\Cuztomisable\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Michael VanDerwerker",
            "email": "michaelvanderwerkerllc@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0.1",
        "illuminate/support": "^11.3|^12.0|^13.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^2.2",
        "larastan/larastan": "^3.10"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VanDmade\\Cuztomisable\\CuztomisableServiceProvider"
            ]
        }
    }
}
